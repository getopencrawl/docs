---
import { root } from "astro:config/server";
import { fileURLToPath } from "node:url";
import type { GetStaticPaths } from "astro";
import { artworkFingerprint, cardId } from "../../scripts/share/metadata.mjs";
import DocsLayout from "../layouts/DocsLayout.astro";
import {
  getDocsStaticPaths,
  getDocsPage,
  getRouteFlags,
  getSidebar,
  getPrevNext,
  getBreadcrumbs,
  getEditUrl,
  getTOC,
  stripBase,
} from "@cloudflare/nimbus-docs/runtime";
import { components } from "../components";
import { docsTabForEntry } from "../navigation";

export const getStaticPaths: GetStaticPaths = async (options) => {
  const artwork = artworkFingerprint(fileURLToPath(root));
  return (await getDocsStaticPaths(options)).map((path) => ({
    ...path,
    cacheKey: path.cacheKey && path.cacheKey + ":" + artwork,
  }));
};

const page = await getDocsPage(Astro);
if (page instanceof Response) return page;
const { entry, Content, headings, markdownUrl } = page;

const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";

const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);

const activeTab = docsTabForEntry(entry.id);
const sidebar = sidebarOn
  ? await getSidebar(currentSlug, {
      collection: entry.collection,
      transform: ({ tree }) => {
        const tab = tree.find((item) => item.label === activeTab?.label);
        return tab?.type === "group" ? tab.children : tree;
      },
    })
  : false;
const prevNext = await getPrevNext(currentSlug, {
  sidebarTree: sidebar === false ? [] : sidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
// Pass `collection` so versioned pages (docs-<v>) get version-prefixed
// breadcrumb hrefs — parity with the getSidebar call above.
const breadcrumbs = await getBreadcrumbs(currentSlug, { collection: entry.collection });
const editUrl = await getEditUrl(entry);
// Show an updated date only when the page author explicitly supplies one.
const lastUpdated = entry.data.lastUpdated;
// `tocOn` already implies `tableOfContents !== false`, but TS can't carry
// that boolean narrowing to the value here — re-check it so `getTOC` only
// ever sees its options object (or undefined), never `false`.
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;
const id = cardId(fileURLToPath(root), entry.data.title, entry.data.description);
const mediaUrl = new URL("/share/" + id, Astro.site).href;
const imageAlt = [entry.data.title, entry.data.description].filter(Boolean).join(" — ");
const mediaHead = [
  ["og:image:type", "image/webp"],
  ["og:image:width", "1200"],
  ["og:image:height", "630"],
  ["og:video", mediaUrl + ".mp4"],
  ["og:video:type", "video/mp4"],
  ["og:video:width", "1200"],
  ["og:video:height", "630"],
  ["og:image", mediaUrl + ".gif"],
  ["og:image:type", "image/gif"],
  ["og:image:width", "1200"],
  ["og:image:height", "630"],
  ["og:image:alt", imageAlt],
].map(([property, content]) => ({ tag: "meta" as const, attrs: { property, content } }));
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={[...(entry.data.head ?? []), ...mediaHead]}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={mediaUrl + ".webp"}
  socialImageAlt={imageAlt}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
>
  <Content components={components} />
</DocsLayout>
